*.db
data.db

# Environment
.env
.env.local

# Downloads (图片内容忽略，保留目录结构)
downloads/**/*
!downloads/.gitkeep
!downloads/*/.gitkeep

# Output (Markdown 内容忽略，保留目录结构)
output/**/*
!output/.gitkeep
!output/*/.gitkeep

# Playwright
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

